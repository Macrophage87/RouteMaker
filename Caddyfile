# The edge. PLAN.md:64-65: Caddy terminates TLS and serves the built frontend
# along with the admin and Ninja assets, and no service but Caddy publishes a
# port.
#
# compose.yaml bind-mounts this file at /etc/caddy/Caddyfile. It did not exist,
# and Docker creates a *directory* at a missing bind-mount source, so Caddy
# started against a directory where it expected a config file.
#
# The site address is read from the environment through Caddy's own `{$VAR}`
# substitution, which happens when the config is loaded, so one file serves both
# deployments: a hostname such as `routes.example.org` gets an automatic
# certificate, and `:80` serves a local stack over plain HTTP. compose passes
# CADDY_SITE_ADDRESS to this service and nothing else; it is not a secret.
{$CADDY_SITE_ADDRESS} {
	# HSTS, on every response this site makes - the static files as much as the
	# proxied ones, which is why it is here and not inside a `handle`.
	#
	# It costs nothing under the `:80` posture and is not wrong there: RFC 6797
	# section 8.1 says a user agent MUST ignore this header when the response
	# did not arrive over a secure transport, so a local plain-HTTP stack
	# neither pins anything nor breaks. Under the hostname posture it is what
	# stops the one request that matters - a browser that has been here before
	# typing the bare name, or following an `http://` link - from leaving on
	# the wire before Caddy's redirect answers it.
	#
	# A year, and deliberately without `includeSubDomains` or `preload`. Both
	# commit names this deployment does not serve: `includeSubDomains` makes
	# every sibling under the same name HTTPS-only for a year, and `preload`
	# is a submission to a browser-shipped list that is slow to leave. Neither
	# is a decision this file can make for whoever runs it.
	header Strict-Transport-Security "max-age=31536000"

	# Preset links (owner item 204): routemaker.cieply.com/trailmaxxing opens the
	# planner on that ride type. Exactly the ride-type ids frontend/src/lib/
	# presets.ts lists - tests/test_preset_links.py holds this list equal to
	# it and to core/presets.py, no extras - each sent to the app's own
	# fragment link, which the planner already reads (planHash.ts), so nothing
	# else is needed to make it work. A fragment never reaches a server.
	#
	# 302, not 308: the list of ride types is the owner's to change, and a
	# browser keeps a permanent redirect with no way for us to take it back, so
	# a renamed or retired id would stay a dead link in every browser that had
	# followed it. The price is one extra round trip, once per visit. (The
	# method is irrelevant: these are GETs.)
	#
	# Case and a trailing slash are accepted - Caddy's `path` matcher ignores
	# case - and the target is always the lowercase id, which is the only
	# spelling the app's parsePreset reads. None of these ids is a route
	# elsewhere in this file or in config/urls.py (/static, /basemap, /assets,
	# /api, /tiles, /auth, /healthz, the admin path), and the test checks that
	# against the URLconf. `redir` is ordered before `handle`, so it needs no
	# block of its own.
	@preset-default path /default /default/
	redir @preset-default /#preset=default 302
	@preset-trailmaxxing path /trailmaxxing /trailmaxxing/
	redir @preset-trailmaxxing /#preset=trailmaxxing 302
	@preset-group-ride path /group-ride /group-ride/
	redir @preset-group-ride /#preset=group-ride 302
	@preset-mass-ride path /mass-ride /mass-ride/
	redir @preset-mass-ride /#preset=mass-ride 302
	@preset-mountain-goat path /mountain-goat /mountain-goat/
	redir @preset-mountain-goat /#preset=mountain-goat 302
	@preset-gravel path /gravel /gravel/
	redir @preset-gravel /#preset=gravel 302
	@preset-fast path /fast /fast/
	redir @preset-fast /#preset=fast 302
	@preset-cargo path /cargo /cargo/
	redir @preset-cargo /#preset=cargo 302
	@preset-ebike path /ebike /ebike/
	redir @preset-ebike /#preset=ebike 302

	# Django's collected assets, from the volume `collectstatic` writes and this
	# service mounts read-only (${DATA_ROOT}/static -> /srv/static). STATIC_URL
	# is "static/", so /static/admin/css/base.css has to resolve to
	# /srv/static/admin/css/base.css: handle_path strips the matched prefix
	# before the file server sees the path, which `handle` would not.
	#
	# This does not shadow the admin. The admin mounts under DJANGO_ADMIN_PATH
	# (config/urls.py, defaulting to `internal-8f3a/`), which is not /static/.
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# The self-hosted base map (PLAN.md "Base map"): the PMTiles extract, the
	# glyphs and the sprites that scripts/fetch_basemap.sh writes under
	# ${DATA_ROOT}/basemap, which compose mounts read-only at /srv/basemap.
	# MapLibre reads region.pmtiles through the pmtiles protocol as HTTP range
	# requests, which file_server answers with 206 and the named bytes. Nothing
	# on this site encodes responses, and nothing may: a compressed body
	# changes what a byte range means.
	#
	# Served only to this site's own pages. A browser sends Origin on a
	# cross-origin fetch and, under the default referrer policy and Django's
	# `same-origin` one, the full Referer on a same-origin one, so the rule is:
	# an Origin, when there is one, must be this site's scheme and host; with
	# none, the Referer must be a page on it (the trailing "/" is what stops
	# http://site.evil.example/ passing as http://site). The comparison is
	# against the request's own scheme and Host, so the one rule serves the
	# `:80` posture and a hostname alike. A request with neither header is
	# refused too. This is a hotlinking guard, not access control: a client
	# that is not a browser can send whatever headers it likes. Two
	# consequences: a browser that strips a same-origin Referer (a privacy
	# extension, a page served with `Referrer-Policy: no-referrer`) gets a
	# blank map, and the rule assumes Caddy is the TLS edge - behind another
	# TLS-terminating proxy {scheme} is http and every https page is refused.
	#
	# The per-IP range-request limit PLAN asks for is NOT here: the stock
	# caddy image (2.8.4, `caddy list-modules`) carries no rate-limit module.
	# Adding one means building Caddy with a third-party module (for example
	# mholt/caddy-ratelimit via xcaddy), which is recorded as an owner item.
	handle_path /basemap/* {
		@foreign not expression `{header.Origin} == {scheme} + "://" + {hostport} || ({header.Origin} == "" && {header.Referer}.startsWith({scheme} + "://" + {hostport} + "/"))`
		respond @foreign 403
		# The contract's three paths and nothing else - not the fetch
		# script's stamps, nor its work directory mid-refresh.
		@unlisted not path /region.pmtiles /fonts/* /sprites/*
		respond @unlisted 404
		# `private`: the answer depends on Origin and Referer, which a shared
		# cache would not key on. The archive revalidates every time (a 304 is
		# cheap), because a refresh replaces it under the same name; the
		# glyphs and sprites only change with a pinned commit.
		header /region.pmtiles Cache-Control "private, no-cache"
		header /fonts/* Cache-Control "private, max-age=86400"
		header /sprites/* Cache-Control "private, max-age=86400"
		# `header` runs before `respond`, so without this a refused glyph
		# would carry the day-long max-age above and a page of ours that lost
		# its Referer once would stay broken for a day. It wins on a refusal
		# not because it is written last but because Caddy sorts same-named
		# directives with path matchers ahead of those with a named matcher,
		# so this one runs after the three above; tests/test_basemap_edge.py
		# checks the header a refusal actually carries.
		header @foreign Cache-Control "no-store"
		root * /srv/basemap
		file_server
	}

	# The public front end (PLAN.md "Frontend"): the static single-page app that
	# `npm run build` writes and the deploy step copies to ${DATA_ROOT}/frontend,
	# which compose mounts read-only at /srv/frontend (docs/DEPLOYMENT.md, "The
	# public front end").
	#
	# The app's own paths are listed rather than the API's, so the edge needs no
	# knowledge of the admin path (settings.ADMIN_PATH, which PLAN keeps out of
	# the bundle) and everything not listed - /api/*, /tiles/*, /auth/*, the
	# admin, /healthz - still reaches the API unchanged. A client-side route
	# added to the app later is added here too; until then an unknown path is
	# the API's 404, as it was.
	#
	# `Referrer-Policy: same-origin`: the page's own requests keep their full
	# Referer, which the /basemap/* guard above needs (MapLibre fetches the
	# archive, glyphs and sprites on the page's thread), while links off the
	# site - the attribution's - carry none. `no-referrer` here would blank the
	# map. index.html revalidates on every load so a deploy is picked up at
	# once; the hashed files under /assets/ never change under their name, so
	# they are cached for good - but only the ones that exist, since a 404
	# cached for a year would outlive the deploy that fixes it.
	#
	# The app's responses are compressed. The rule in the /basemap/* block
	# that nothing may encode is about byte ranges into the archive; it does
	# not reach this block, and the app's main script is ~1.3 MB raw and
	# ~370 KB gzipped, which matters on a phone.
	#
	# The Content-Security-Policy is the app's own: every request it makes is
	# to this site (PLAN.md:15, no third-party tile servers), MapLibre's worker
	# is a same-origin file, and MapLibre sets inline styles. frame-ancestors
	# refuses framing. licenses.txt is the bundled packages' licence notices,
	# which the build writes and the map's credits link to. /about/stress.html is
	# the rider-facing page on how traffic-stress ratings work (OWNER-DECISIONS
	# 461; frontend/public/about/stress.html), which the legend and the road panel
	# link to; /about/stress and /about/stress/ redirect to it. 302, not 301, for
	# the preset links' reason above: a browser keeps a permanent redirect with no
	# way for us to take it back, so a rollback or a later move of the page would
	# leave it pointing at the API's 404.
	@stress-page path /about/stress /about/stress/
	redir @stress-page /about/stress.html 302
	@frontend path / /index.html /favicon.svg /licenses.txt /about/stress.html /assets/*
	handle @frontend {
		encode zstd gzip
		header Referrer-Policy "same-origin"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		root * /srv/frontend
		@hashed {
			path /assets/*
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		header /licenses.txt Cache-Control "no-cache"
		header /about/stress.html Cache-Control "no-cache"
		header /favicon.svg Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else is the API, on the port docker/api-entrypoint.sh binds
	# gunicorn to. Photon, Valhalla and the renderer are deliberately absent:
	# PLAN.md:65 says they are reachable only through the API, which proxies
	# geocoding behind session authentication and a per-user rate limit Photon
	# has no notion of a user to enforce itself. A route here for any of them
	# would publish them to the internet, which is the one thing this file's
	# service exists to avoid.
	handle {
		# The stress tiles (GET /tiles/stress/..., core/stress_tiles.py) are
		# compressed here: a vector tile is protobuf, and the z14 tile over
		# downtown DC measured 124 KB raw and 55 KB gzipped. Caddy's default
		# list of compressible types does not include the vector-tile type,
		# hence the match - which is also what keeps every other answer of
		# the API's as it is.
		encode zstd gzip {
			match {
				header Content-Type application/vnd.mapbox-vector-tile*
			}
		}
		reverse_proxy api:8000 {
			# Caddy terminates TLS, so the request reaching Django is plain
			# HTTP. settings.SECURE_PROXY_SSL_HEADER reads
			# HTTP_X_FORWARDED_PROTO; without this header request.is_secure()
			# is false behind TLS, which breaks the CSRF origin check on every
			# https form post and makes Django build http:// redirects.
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
