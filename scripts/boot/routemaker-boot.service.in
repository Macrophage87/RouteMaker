# systemd USER unit: start the RouteMaker stack once the WSL binds exist.
# Template: @REPO@ is replaced by scripts/boot/install-boot-unit.sh with the
# absolute path of this checkout. Runs as the user, no sudo. For it to run at
# boot without anyone logging in, user lingering must be on once:
#   sudo loginctl enable-linger "$USER"
[Unit]
Description=RouteMaker stack start (waits for Docker and the WSL bind paths, checks postgis)
Documentation=file://@REPO@/docs/DEPLOYMENT.md

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/boot/start-stack.sh
# Worst case of the script's own bounds, in seconds (defaults):
#   Docker + bind paths + bind check, one shared budget        900
#     plus a 60 s `docker info` running past its end, then
#     one full bind-check attempt (3 x 60), plus one poll       245
#   ps for the mode, 3 tries of 30 s + 2 x 10 s gaps           110
#   postgis sanity, 3 tries of a 60 s exec + 2 x 15 s gaps     210
#   the 11 mutating compose calls of the longest path:
#     stop + postgis + caddy, api, worker, rebuild at 120,
#     4 routers + photon at 300                               2220
#   postgis healthy 300 + one 30 s ps + poll                   335
#   sanity after the recreate, retried like the one above      210
#   smoke 300 + one round of 3 x 90 s requests + poll          575
#   total                                                     4805
# (An abort path's best-effort `stop postgis` replaces the starts, so it is
# covered.) This backstop sits above that. If it fires, systemd sends SIGTERM
# and the script records FAILED in last-status before it exits.
TimeoutStartSec=5400
# A failure is deliberate (empty postgis, missing paths): do not retry in a loop.
Restart=no

[Install]
WantedBy=default.target
