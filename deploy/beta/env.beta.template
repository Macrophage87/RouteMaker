# The beta server's .env, made from .env.example's variables with the beta's values.
#
# Do not copy this to .env by hand: scripts/beta/make-env.sh does it. It fills every value
# marked for generation with a fresh random value (hex, so no `$` or quote ever needs escaping:
# compose reads `$` in .env as an expansion), writes the file mode 600, and refuses to
# overwrite an existing .env. No secret is in this template or anywhere in the repo.
#
# docker compose reads .env itself. Nothing should `source` it (docs/DEPLOYMENT.md).

# --- identity of this stack ------------------------------------------------------
# Distinct from any other compose project on the host. The beta wrapper
# (scripts/beta/beta-compose.sh) refuses to run without it.
COMPOSE_PROJECT_NAME=routemaker-beta

# Names the api/worker/migrate image. make-env.sh sets it to the 12-character git sha
# being deployed, so a rollback can start the previous image instead of rebuilding it.
TAG=@TAG@

# Everything stateful lives under here, on the big volume (not the small root disk).
DATA_ROOT=@DATA_ROOT@

# --- required secrets: generated, never typed --------------------------------------
# The Django signing key.
DJANGO_SECRET_KEY=@GENERATE@
# Keys the ban tombstones; settings.py refuses to start without it.
KEY_ENCRYPTION_KEY=@GENERATE@
# The PostgreSQL password. The database is created with it on first start, so changing
# it later means changing it inside PostgreSQL too (docs/DEPLOYMENT.md, "Secrets").
PGPASSWORD=@GENERATE@
PGDATABASE=routemaker
PGUSER=routemaker

# --- the public origin: one decision, four places ------------------------------------
DJANGO_ALLOWED_HOSTS=routemaker.cieply.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://routemaker.cieply.com
# DJANGO_DEBUG stays unset (make-env.sh never writes it): the site is https, cookies are Secure.
# RESTART_POLICY stays unset too, so compose.yaml's default `unless-stopped` applies: this is a
# normal Linux host. (`no` is the Docker Desktop home machine's setting; the checker and
# beta-compose.sh refuse it here.)
# DJANGO_ADMIN_PATH keeps its default; the admin is only reachable by an instance admin.

# --- Discord sign-in: OPTIONAL ----------------------------------------------------------
# Planning works signed out (OWNER-DECISIONS: anonymous planning). Leave these empty and
# the beta has no sign-in; saved routes and community features are simply unavailable.
# To turn it on, add this redirect to the Discord application's OAuth2 settings:
#   https://routemaker.cieply.com/auth/callback
# and fill in the three values from that application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://routemaker.cieply.com/auth/callback
# The one Discord user id that becomes the first instance admin on first sign-in. The beta's
# database starts with no accounts (OWNER-DECISIONS 367.3), so this is how the owner claims
# admin there afresh: set it to the owner's id only if Discord sign-in is turned on, and have
# the owner sign in once promptly after the api starts. Leave it empty otherwise.
BOOTSTRAP_INSTANCE_ADMIN_DISCORD_ID=

# --- beta sizing: compose.beta.yaml reads these -------------------------------------------
# The api's localhost port nginx proxies to. Pick one that `ss -ltn` shows free.
BETA_API_PORT=@API_PORT@
# 6 gunicorn workers: two route plans at once, two place searches, one stress-tile draw,
# and one worker always free for /healthz (OWNER-DECISIONS 367.2; compose.beta.yaml has the
# arithmetic). The api's 1450M cap is sized for 6; the checker refuses more than 6.
BETA_WEB_CONCURRENCY=6

# Not set on purpose: SOURCE_EXTRACT_*, COVERAGE_POLYGON (rebuild only; there is no rebuild
# on the beta), CADDY_SITE_ADDRESS (there is no Caddy), the bot's DISCORD_BOT_TOKEN and
# BOT_INTERNAL_SECRET (the bot is not built). No VDOT token variable exists in this
# release, so there is nothing to set for it.
