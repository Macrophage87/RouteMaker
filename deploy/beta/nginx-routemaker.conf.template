# nginx site for the RouteMaker private beta (OWNER-DECISIONS 360-362).
#
# TEMPLATE: scripts/beta/render-nginx.sh fills the placeholders written between @ signs
# TEMPLATE: and keeps one of the two stages below; docs/BETA-RUNBOOK.md says when to use each.
# TEMPLATE: (Lines starting `# TEMPLATE:` are dropped from the rendered file.)
# @RENDERED_FROM@
#
# Installing it adds one config file (plus its own two log files, below) to the host's nginx and changes nothing else:
# no default_server, no edit to nginx.conf, no http-level setting that another
# site would inherit. Every http-level name it declares (the upstream, the map,
# the log format) is prefixed `rmbeta_` so it cannot collide with a site that is
# already there.
#
# Its access log leaves out query strings, the client address and the tester's name
# (`rmbeta_noquery`, the path only): a new point is reverse-geocoded as
# /api/reverse?lat=..&lon=.., a search sends the map centre, which after "Use my
# location" is the rider's own spot, and the map's road panel asks
# /api/segment-info?lat=..&lon=.. for the spot right-clicked (OWNER-DECISIONS 395: the
# position is never logged beyond the route request; 441a). Those three paths also log
# errors at `crit` only, to their own
# file, because an upstream error line records the whole request, query included.
# gunicorn's access log already strips query strings (docker/api-entrypoint.sh).
# nginx creates two files of its own: /var/log/nginx/rmbeta-access.log and rmbeta-error.log.
#
# It does what compose.yaml's Caddy does today (Caddyfile), minus Caddy's own TLS:
#   /                    the built front end, static
#   /static/             Django's collected static files
#   /basemap/            the self-hosted base map, same-origin requests only
#   /<preset>            the 302 redirects to /#preset=<preset>
#   everything else      the api on 127.0.0.1:@API_PORT@
# and adds what a public-internet beta needs: HTTP basic auth, X-Robots-Tag, robots.txt.
#
# Public (no basic auth), and ONLY these:
#   /robots.txt                         so a crawler is told to go away rather than shown a login
#   /.well-known/acme-challenge/        port 80 only, for Let's Encrypt validation
#   /delete-account                     Google Play's deletion link must open without the app
#                                       or a password (the owner, 2026-10-19); deleting still
#                                       needs a Discord sign-in, which stays behind the password
#   /privacy                            the privacy policy, whose link Google Play's listing
#                                       needs, also without the app or a password
#   /garmin/deregistrations             Garmin's server's notice that a rider disconnected in
#                                       Garmin Connect (core.garmin_views); it has no password
# Everything else, including /healthz, /auth/ and the admin path, is behind basic auth.
# Basic auth is in front of Discord sign-in, which stays optional and works through it:
# the browser sends the same credentials on the redirect back from Discord.
#
# add_header does not inherit into a location that has its own add_header, so every
# location that sets one repeats X-Robots-Tag (all but the favicons and /icons/, for the
# connector's icon) and Strict-Transport-Security;
# tests/test_beta_overlay.py fails if one is missed.
#
# IPv6: the `listen [::]:...` lines are kept only if the host's other sites listen on IPv6
# too; render with --no-ipv6 otherwise (on a host with IPv6 disabled `nginx -t` fails on them).

# BEGIN stage:acme
# Stage 1, before a certificate exists: port 80, answering only the ACME challenge.
# Install this, run `certbot certonly --webroot -w @ACME_ROOT@ -d @SERVER_NAME@`, then
# re-render with --stage full and the certificate paths. (Not certbot's --nginx
# authenticator: it edits and reloads the host's nginx config at issue and at every renewal.)
server {
    listen 80;
    listen [::]:80;
    server_name @SERVER_NAME@;

    add_header X-Robots-Tag "noindex, nofollow" always;

    location ^~ /.well-known/acme-challenge/ {
        root @ACME_ROOT@;
        default_type text/plain;
        auth_basic off;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location / {
        return 404;
    }
}
# END stage:acme

# BEGIN stage:full
# The path only, never the query string ($uri, not $request or $request_uri), no Referer, and
# no client address or tester name ($remote_addr, $remote_user): none of them is needed here.
log_format rmbeta_noquery '[$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time';

upstream rmbeta_api {
    server 127.0.0.1:@API_PORT@;
    keepalive 8;
}

# The base map is for this site's own pages only (Caddyfile: /basemap/*). Key is
# "<Origin>|<Referer>": allowed when the Origin is this site, or when there is no
# Origin and the Referer is a page on this site. Anything else is foreign.
map "$http_origin|$http_referer" $rmbeta_basemap_foreign {
    default 1;
    "~^https://@SERVER_NAME_RE@\|" 0;
    "~^\|https://@SERVER_NAME_RE@/" 0;
}

# A link fetcher (a chat app, social site or search engine making a link's preview), as
# core.share_preview.is_fetcher and the Caddyfile's @link_fetcher tell it: its User-Agent names a
# fetcher and it is no browser navigation (tests/test_link_preview.py holds the three patterns
# equal). Key is "Sec-Fetch-Mode|User-Agent"; the first regex that matches wins.
map "$http_sec_fetch_mode|$http_user_agent" $rmbeta_link_fetcher {
    default 0;
    "~*^navigate\|" 0;
    "~*^[^|]*\|.*(bot\b|bot/|crawler|spider|facebookexternalhit|facebot|slack|whatsapp|telegram|skypeuripreview|embedly|iframely|mastodon|pleroma|pinterest|vkshare|googlemessages|preview)" 1;
}

# Port 80: ACME challenges stay answerable (renewals), everything else goes to https.
server {
    listen 80;
    listen [::]:80;
    server_name @SERVER_NAME@;

    add_header X-Robots-Tag "noindex, nofollow" always;

    location ^~ /.well-known/acme-challenge/ {
        root @ACME_ROOT@;
        default_type text/plain;
        auth_basic off;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    access_log /var/log/nginx/rmbeta-access.log rmbeta_noquery;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # nginx 1.25.1 or newer. On an older nginx, delete this line and put `http2`
    # after `ssl` on the two listen lines; `nginx -t` says which is needed.
    http2 on;
    server_name @SERVER_NAME@;

    access_log /var/log/nginx/rmbeta-access.log rmbeta_noquery;

    ssl_certificate     @CERT_FULLCHAIN@;
    ssl_certificate_key @CERT_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    @TLS_OPTIONS_INCLUDE@

    # --- the beta's gate ---------------------------------------------------------
    # Not for indexing, and behind a password. The htpasswd file is made on the
    # server by scripts/beta/make-htpasswd.sh; it is never in the repository.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    auth_basic           "RouteMaker beta";
    auth_basic_user_file @HTPASSWD_FILE@;
    # What Cancel shows, instead of nginx's bare "401 Authorization Required" (final review,
    # accessibility N1): a short page saying how to get in and who to ask. The status stays 401
    # and the WWW-Authenticate header stays, so the browser's own sign-in box still comes first
    # (scripts/beta/smoke-test.sh --public checks both).
    error_page 401 /rmbeta-401.html;
    # What a tester sees when the api is not answering at all (a release restarting it, the
    # runbook's "Updates"), instead of nginx's bare "502 Bad Gateway": what is happening, that
    # Back returns to the route, and when to tell someone. Only nginx's own 502: without
    # proxy_intercept_errors the api's own answers, its JSON 502 included, pass through as they are.
    error_page 502 /rmbeta-502.html;

    client_max_body_size 1m;

    # JSON and vector tiles compress well; the base map archive and images do not.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types application/json application/vnd.mapbox-vector-tile text/plain text/css
               application/javascript text/javascript image/svg+xml;

    # --- public: robots.txt ------------------------------------------------------
    # A crawler may read the home page and the icons, and nothing else: Google's favicon service,
    # which claude.ai's connector list takes a connector's icon from, needs both (docs/
    # OPERATIONS.md, "The connector's icon"). The home page still says noindex, so it stays out
    # of search results.
    location = /robots.txt {
        auth_basic off;
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        return 200 "User-agent: *\nAllow: /$\nAllow: /favicon.ico\nAllow: /favicon.svg\nAllow: /icons/\nDisallow: /\n";
    }

    # --- the sign-in page (error_page 401 above): internal only, so never served directly, and
    # outside the password because it is what someone without one sees. deploy/beta/401.html in
    # the checkout. ------------------------------------------------------------------------------
    location = /rmbeta-401.html {
        internal;
        auth_basic off;
        alias @PAGES_DIR@/401.html;
        default_type text/html;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
    }

    # --- the "back soon" page (error_page 502 above): internal only. Unlike the sign-in page it
    # stays behind the password, since a 502 only follows a request that got past it.
    # deploy/beta/502.html in the checkout. ----------------------------------------------------
    location = /rmbeta-502.html {
        internal;
        alias @PAGES_DIR@/502.html;
        default_type text/html;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
    }

    # --- public: the account-deletion page (core.account_deletion) -----------------
    # Google Play's rule: a web link that says how to delete an account, usable without the app
    # (the owner chose to open it on the beta, 2026-10-19). Only this one exact path. The page's
    # delete button needs a Discord session, and /auth/ stays behind the password.
    location = /delete-account {
        auth_basic off;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    # --- public: the privacy policy (core.privacy_policy) ---------------------------
    # Google Play's listing links to it, so like the deletion page it opens without the password.
    # Only this one exact path, and a static page: no form, nothing of an account.
    location = /privacy {
        auth_basic off;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    # --- public: Garmin's deregistration notice (core.garmin_views.deregistrations) ---
    # Garmin's servers post it when a rider disconnects RouteMaker in Garmin Connect; they have no
    # password. Only this one exact path; the notice can only end connections it names.
    location = /garmin/deregistrations {
        auth_basic off;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    # --- public: link previews (core.share_preview) ---------------------------------
    # A chat app making a link's preview has no password (the owner, 2026-10-20: "Is there a way
    # to have the icon when shared?"). A shared route's link and its image: the api gives a
    # fetcher the preview's tags and a browser a redirect into the app, which stays behind the
    # password. And the app's own address as a fetcher sees it, which `location = /` hands a
    # fetcher: the name, a line on what the app does and the icon's card. The icons and the
    # favicon below are outside the password too; they are the repository's own files.
    location ~ ^/s/[^/]+(/preview\.png)?$ {
        auth_basic off;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    location = /link-preview {
        auth_basic off;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    # --- the front end (Caddyfile @frontend) --------------------------------------
    # The same security headers Caddy sets, the same CSP verbatim.
    location = / {
        # A link fetcher gets the app's preview tags instead (the map above, /link-preview).
        if ($rmbeta_link_fetcher) {
            rewrite ^ /link-preview last;
        }
        root @DATA_ROOT@/frontend;
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /index.html {
        root @DATA_ROOT@/frontend;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /licenses.txt {
        root @DATA_ROOT@/frontend;
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "no-cache" always;
    }

    # The rider-facing pages (Caddyfile @frontend): how traffic-stress ratings work
    # (OWNER-DECISIONS 461; frontend/public/about/stress.html) and the rest of the
    # documentation beside it, with the app's headers and CSP. Exactly these names, as
    # the Caddyfile lists them; any other /about/ path still reaches the app.
    location ~ ^/about/((stress|how-it-works|using|accessibility|routing|ride-types|mass-ride|trails|architecture|assistants|acknowledgements)\.html|route-example\.webp)$ {
        root @DATA_ROOT@/frontend;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header Cache-Control "no-cache" always;
    }

    # The short paths, as the Caddyfile's @stress-page: 302 (a browser keeps a
    # permanent redirect for good), and ~* because Caddy's `path` matcher ignores case.
    location ~* ^/about/stress/?$ {
        return 302 /about/stress.html;
    }

    # The favicons and the icons carry no noindex: they are the app's logo, and Google's favicon
    # service (the connector's icon, robots.txt above) may skip an image marked noindex.
    location ~ ^/favicon\.(svg|ico)$ {
        auth_basic off;
        root @DATA_ROOT@/frontend;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # The installable app (Caddyfile @frontend; WEB-NAV-plan.md section 8): its service worker and
    # manifest revalidate on every load, as index.html does, so a deploy or the kill switch
    # (docs/OPERATIONS.md) reaches every browser at once; its icons keep a day, like the favicon.
    # The worker and manifest stay behind the password: index.html asks for the manifest with
    # credentials (crossorigin="use-credentials"), and the browser sends them with the worker's own
    # fetches. The icons are outside it, for link previews (above).
    # sw-kill.js is not served: it is copied over sw.js on disk when needed.
    location = /sw.js {
        root @DATA_ROOT@/frontend;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache" always;
    }

    # A Featured routes post's script (Caddyfile @frontend; core/route_posts.py names it): a fixed name,
    # so it revalidates on every load. The posts themselves, /routes/*, go to the app below.
    location = /post.js {
        root @DATA_ROOT@/frontend;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /manifest.webmanifest {
        root @DATA_ROOT@/frontend;
        # An older nginx's mime.types has no webmanifest line.
        types { }
        default_type application/manifest+json;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /icons/ {
        auth_basic off;
        root @DATA_ROOT@/frontend;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # Hashed file names: a changed file is a new name, so they never change.
    location ^~ /assets/ {
        root @DATA_ROOT@/frontend;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # --- preset links (Caddyfile @preset-*) ----------------------------------------
    location ~ ^/(default|trailmaxxing|group-ride|mass-ride|mountain-goat|mountain-bike|gravel|fast|cargo|ebike|bikeshare|novice|bike-transit|bikeshare-transit|rebalance)/?$ {
        return 302 "/#preset=$1";
    }
    # Riding with kids became Novice and Nervous (v0.7.0; Caddyfile @renamed-kids): the old short link opens it.
    location ~ ^/kids/?$ {
        return 302 "/#preset=novice";
    }

    # --- Django's collected static files (Caddyfile handle_path /static/*) -----------
    location ^~ /static/ {
        alias @DATA_ROOT@/static/;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
    }

    # --- the base map (Caddyfile handle_path /basemap/*) -----------------------------
    # Same-origin only, and only the paths the app asks for; any other path is a
    # 404 for this site's own pages and a 403 for anyone else. pmtiles is read with
    # Range requests, which nginx answers natively.
    location = /basemap/region.pmtiles {
        if ($rmbeta_basemap_foreign) {
            add_header Cache-Control "no-store" always;
            add_header X-Robots-Tag "noindex, nofollow" always;
            return 403;
        }
        alias @DATA_ROOT@/basemap/region.pmtiles;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "private, no-cache" always;
    }

    # The topo lines' contours (scripts/build_contours.py; frontend/src/lib/topoLines.ts), as the
    # Caddyfile serves them: same-origin, revalidated, a 404 until the build host writes the file.
    location = /basemap/contours.pmtiles {
        if ($rmbeta_basemap_foreign) {
            add_header Cache-Control "no-store" always;
            add_header X-Robots-Tag "noindex, nofollow" always;
            return 403;
        }
        alias @DATA_ROOT@/basemap/contours.pmtiles;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "private, no-cache" always;
    }

    location ^~ /basemap/fonts/ {
        if ($rmbeta_basemap_foreign) {
            add_header Cache-Control "no-store" always;
            add_header X-Robots-Tag "noindex, nofollow" always;
            return 403;
        }
        alias @DATA_ROOT@/basemap/fonts/;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "private, max-age=86400" always;
    }

    location ^~ /basemap/sprites/ {
        if ($rmbeta_basemap_foreign) {
            add_header Cache-Control "no-store" always;
            add_header X-Robots-Tag "noindex, nofollow" always;
            return 403;
        }
        alias @DATA_ROOT@/basemap/sprites/;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cache-Control "private, max-age=86400" always;
    }

    location ^~ /basemap/ {
        if ($rmbeta_basemap_foreign) {
            add_header Cache-Control "no-store" always;
            add_header X-Robots-Tag "noindex, nofollow" always;
            return 403;
        }
        return 404;
    }

    # --- reverse look-ups, searches and road panels: a location in the query -----------
    # /api/reverse?lat=..&lon=.., /api/geocode?q=..&lat=..&lon=.. and
    # /api/segment-info?lat=..&lon=.. (OWNER-DECISIONS 441a), and /api/street-photo?lon=..&lat=..
    # (v0.7.0), and from v0.7.0 too /api/junction-suggestions/at?lat=..&lon=..,
    # /api/stress-suggestions/ticket?way=.., /api/stress-suggestions/mine?way=..,
    # /api/transit/station-times?lon=..&lat=.., /api/transit/next-vehicle?lon=..&lat=.. (v0.9.0),
    # /api/bikeshare/docks?bbox=.., /api/closures/map?bbox=.. (v0.12.0), and Review's
    # /api/review/items?way=.., /api/review/map?west=.., /api/review/next?way=..,
    # /api/review/road/<way> and /api/review/street-photo?lon=..&lat=.., and the connector's
    # /api/scenic-roads?lat=..&lon=.. and /api/climbs-near?lat=..&lon=.. from v0.12.3: each holds
    # a way, a point or the area viewed. An upstream error line (a
    # 502 while the api restarts on a deploy, a 504, a worker gunicorn killed) records the
    # request with its query, so these log only `crit` errors, to their own file
    # (OWNER-DECISIONS 395). This loses their upstream diagnostics; the api's own log still
    # has its side. The proxy settings are location /'s below, line for line.
    location ~ ^/api/(reverse|geocode|segment-info|street-photo|junction-suggestions/at|stress-suggestions/ticket|stress-suggestions/mine|transit/station-times|transit/next-vehicle|bikeshare/docks|closures/map|review/items|review/map|review/next|review/road/[0-9]+|review/street-photo|scenic-roads|climbs-near)/?$ {
        error_log /var/log/nginx/rmbeta-error.log crit;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    # --- saved and shared routes and the account's own paths: larger bodies -------------------------
    # A saved route is up to 4 MB (core.accounts.ROUTE_MAX_BYTES), a shared one 2 MB; the
    # server's 1m would refuse them with nginx's own 413. 5m, as the Caddyfile's @routes_body
    # and Django's DATA_UPLOAD_MAX_MEMORY_SIZE. The proxy settings are location /'s below.
    location ~ ^/api/(shared-routes|me)(/|$) {
        client_max_body_size 5m;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    # --- the MCP connector and its sign-in, past the password ---------------------------
    # The site's own MCP connector (src/core/connector.py, v0.10.0): an assistant's servers call
    # these, and they cannot type the beta's password. Each carries its own credential instead: a
    # rider's OAuth token for /mcp, a code and its PKCE verifier for /oauth/token. The rider's
    # own pages (/oauth/authorize, /auth/) stay behind the password. The proxy settings are
    # location /'s below.
    location ~ ^/(mcp|oauth/(register|token)|\.well-known/oauth-(protected-resource(/mcp)?|authorization-server))$ {
        auth_basic off;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }

    # --- everything else is the api (Caddyfile's final handle) ------------------------
    # /api/, /tiles/stress/, /auth/, /healthz, and the admin path. A plan takes up to
    # 47 s (gunicorn kills a worker at 60 s), so the timeouts here are longer than
    # that, so the api's own answer reaches the browser rather than nginx's 504.
    location / {
        proxy_pass http://rmbeta_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Replaced, not appended: the api rate-limits on the last entry, and
        # Caddy overwrites a client-sent value the same way.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
    }
}
# END stage:full
