    <string name="setup_title">Which RouteMaker site?</string>
    <string name="setup_about">This app opens a RouteMaker website. Type its address once; it is kept on this phone only.</string>
    <string name="setup_label">Site address</string>
    <string name="setup_hint">https://routes.example.org</string>
    <string name="setup_go">Continue</string>
    <string name="setup_checking">Checking the site…</string>
