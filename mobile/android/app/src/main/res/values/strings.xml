    <string name="setup_built_fixed">This build was made with its own site address, which it keeps using.</string>
    <string name="shortcut_site_short">Site address</string>
    <string name="shortcut_site_long">Change the site address</string>

    <!-- The site's own password (HTTP basic auth). -->
    <string name="login_title">Sign in to the site</string>
    <string name="login_about">%1$s asks for a user name and password. They are used for this visit only.</string>
    <string name="login_user">User name</string>
